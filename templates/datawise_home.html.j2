<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ company_name | default('Data WiseGuys, LLC') }}</title>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-72FM3KNC3X"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-72FM3KNC3X');
  </script>
  <style>
    :root { color-scheme: light; --bg:#f8f9f6; --surface:#fff; --ink:#142d35; --muted:#52666b; --brand:#086b60; --brand-strong:#064f48; --line:#dce5e1; --radius:16px; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; scroll-padding-top:24px; }
    body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.6 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:inherit; text-underline-offset:4px; }
    img { display:block; max-width:100%; }
    h1,h2,h3,h4,p { margin:0; }
    h1,h2,h3,h4 { line-height:1.15; letter-spacing:-.035em; }
    :focus-visible { outline:3px solid var(--brand); outline-offset:5px; }
    .skip-link { position:absolute; top:12px; left:16px; transform:translateY(-160%); z-index:10; padding:12px 20px; background:var(--ink); color:#fff; border-radius:8px; }
    .skip-link:focus { transform:none; }
    .site-shell { max-width:1180px; margin:auto; padding:0 32px 28px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:28px 0; border-bottom:1px solid var(--line); }
    .brand-lockup { display:flex; flex-direction:column-reverse; gap:3px; }
    .brand-name { font-size:20px; font-weight:750; letter-spacing:-.035em; text-decoration:none; }
    .brand-kicker { font-size:11px; letter-spacing:.07em; color:var(--muted); }
    .topnav,.hero-actions,.project-actions,.social-row,.profile-links { display:flex; align-items:center; flex-wrap:wrap; gap:12px; }
    .nav-pill,.hero-action,.project-action,.social-pill,.profile-link { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:10px 16px; border:1px solid transparent; border-radius:9px; text-decoration:none; font-size:14px; font-weight:600; transition:background 160ms ease,color 160ms ease,border-color 160ms ease; }
    .nav-pill:hover,.hero-action:hover,.project-action:hover,.social-pill:hover,.profile-link:hover { background:#e8efeb; }
    .nav-pill-accent,.hero-action-primary,.project-action-primary { background:var(--brand); color:#fff; }
    .nav-pill-accent:hover,.hero-action-primary:hover,.project-action-primary:hover { background:var(--brand-strong); }
    .hero-grid { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(240px,.7fr); gap:64px; align-items:center; padding:80px 0; }
    .eyebrow,.panel-label { color:var(--brand); font-size:11px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
    .hero-copy h1 { margin-top:16px; max-width:16ch; font-size:clamp(2.5rem,5.5vw,4rem); line-height:1.08; font-weight:650; }
    .hero-text { margin-top:24px; max-width:53ch; font-size:18px; color:var(--muted); }
    .hero-actions { margin-top:28px; }
    .hero-action { padding:13px 20px; }
    .hero-panel { padding:28px; background:#edf2ed; border:1px solid var(--line); border-radius:var(--radius); }
    .hero-logo-shell { padding:12px; background:white; border-radius:10px; }
    .hero-logo { width:100%; height:auto; aspect-ratio:5/4; object-fit:contain; }
    .hero-panel .panel-label { margin-top:24px; }
    .portfolio-summary { margin-top:8px; color:var(--muted); font-size:14px; }
    .portfolio-summary strong { color:var(--ink); font-weight:650; }
    .page-sections { display:grid; gap:80px; }
    .section-shell { border-top:1px solid var(--line); padding-top:40px; }
    .section-heading { display:flex; justify-content:space-between; align-items:end; gap:32px; margin-bottom:32px; }
    .section-heading h2 { margin-top:8px; font-size:clamp(2rem,3.5vw,2.5rem); font-weight:650; }
    .section-heading>p { max-width:44ch; color:var(--muted); font-size:15px; }
    .project-group + .project-group { margin-top:40px; }
    .project-group-heading { margin-bottom:16px; }
    .project-group-heading h3 { font-size:16px; font-weight:600; letter-spacing:0; }
    .project-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
    .project-card { display:flex; flex-direction:column; gap:24px; padding:24px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); box-shadow:0 3px 12px #142d3504; }
    .project-media { display:grid; place-items:center; height:144px; padding:16px; background:#f3f6f3; border-radius:10px; }
    .project-logo { width:220px; height:112px; object-fit:contain; }
    .project-status { display:inline-block; margin-bottom:12px; padding:4px 8px; border-radius:5px; color:var(--brand-strong); background:#e8f3ed; font-size:11px; font-weight:650; }
    .project-status-developing { background:#f1eee7; color:#6c5634; }
    .project-card h4 { font-size:24px; font-weight:650; }
    .project-description { margin-top:12px; color:var(--muted); line-height:1.65; }
    .project-card-footer { margin-top:auto; display:flex; flex-direction:column; gap:12px; }
    .project-actions { order:2; }
    .social-row { gap:4px 12px; }
    .social-pill,.profile-link { padding:4px 0; border-radius:3px; font-size:12px; color:var(--muted); }
    .social-pill:hover,.profile-link:hover { background:transparent; color:var(--brand); text-decoration:underline; }
    .empty-note { font-size:13px; color:var(--muted); }
    .team-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
    .team-card { display:grid; grid-template-columns:112px minmax(0,1fr); align-items:start; gap:24px; }
    .team-photo,.team-photo-placeholder { width:112px; height:140px; object-fit:cover; border-radius:12px; }
    .team-photo-placeholder { display:grid; place-items:center; background:var(--brand); color:#fff; font-size:32px; }
    .team-copy h3 { font-size:24px; font-weight:650; }
    .member-role { margin-top:8px; color:var(--brand); font-size:14px; font-weight:600; }
    .member-description { margin-top:12px; color:var(--muted); font-size:14px; }
    .profile-links { margin-top:12px; }
    .site-footer { margin-top:80px; border-top:1px solid var(--line); padding-top:40px; }
    .contact-row { display:flex; justify-content:space-between; align-items:center; gap:24px; }
    .contact-row h2 { font-size:clamp(1.6rem,3vw,2rem); font-weight:650; }
    .panel-email { display:inline-block; margin-top:12px; color:var(--muted); overflow-wrap:anywhere; }
    .footer-bottom { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px; margin-top:40px; padding-top:20px; border-top:1px solid var(--line); }
    .footer-note { color:var(--muted); font-size:12px; }
    @media(max-width:900px) { .hero-grid { gap:32px; } .team-grid { grid-template-columns:1fr; gap:32px; } }
    @media(max-width:760px) { .site-shell { padding:0 20px 24px; } .topbar { flex-wrap:wrap; gap:16px; padding:20px 0; } .hero-grid { grid-template-columns:1fr; padding:48px 0; } .hero-panel { display:none; } .hero-copy h1 { max-width:18ch; } .hero-text { font-size:17px; } .section-heading { align-items:start; flex-direction:column; gap:16px; } .project-grid { grid-template-columns:1fr; } .page-sections { gap:48px; } .site-footer { margin-top:48px; } .contact-row { flex-direction:column; align-items:start; } }
    @media(max-width:400px) { .site-shell { padding-inline:16px; } .project-card { padding:18px; } .hero-action { padding-inline:14px; } .team-card { grid-template-columns:80px minmax(0,1fr); gap:16px; } .team-photo,.team-photo-placeholder { width:80px; height:100px; } .topnav { gap:4px; } }
    @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; } }
  </style>
</head>
<body>
  {% set company_name = company_name | default('Data WiseGuys, LLC') %}
  {% set company_tagline = company_tagline | default('We build tools that simplify everyday work, from social publishing and personal notes to coding workflows and data analysis.') %}
  {% set company_email = company_email | default('datawiseguysllc@gmail.com') %}
  {% set company_logo_url = company_logo_url | default('output/assets/data_wiseguys_logo_20230401.webp') %}
  {% set social_links = social_links | default({
    'x': '#',
    'facebook': '#',
    'instagram': '#',
    'tiktok': '#'
  }) %}
  {% set projects = projects | default([
    {
      'name': 'SocialSync',
      'logo_url': 'output/assets/socialsync_logo.webp',
      'logo_alt': 'SocialSync logo',
      'contact_email': 'socialsyncdwg@gmail.com',
      'status': 'Released',
      'description': 'Plan, create, and schedule social content in one workspace. Bring your publishing workflows and analytics together across Facebook, Instagram, X, and TikTok.',
      'site_url': 'https://www.socialsyncdwg.com',
      'social_handles': {
        'x': 'https://x.com/socialsyncdwg',
        'facebook': 'https://www.facebook.com/profile.php?id=61586199493081',
        'instagram': 'https://www.instagram.com/socialsyncdwg/',
        'tiktok': 'https://www.tiktok.com/@rolandheinze3?_r=1&_t=ZT-94lRhOOmUYP',
        'discord': 'https://discord.gg/WUGqSXsryD'
      }
    },
    {
      'name': 'Ledger Lite',
      'logo_url': 'output/assets/voice_ledger_lite_logo.webp',
      'logo_alt': 'Ledger Lite logo',
      'contact_email': 'datawiseguysllc@gmail.com',
      'status': 'Released',
      'description': 'Capture notes. Find what matters. An Android journal with on-device notes, automatic summaries, and semantic search.',
      'site_url': 'https://www.ledgerlitedwg.com',
      'social_handles': {'x': '#', 'facebook': '#', 'instagram': '#', 'tiktok': '#', 'discord': '#'}
    },
    {
      'name': 'ProspectRecon',
      'logo_url': 'output/assets/prospectrecon_logo_20260317.webp',
      'logo_alt': 'ProspectRecon logo',
      'contact_email': '',
      'status': 'Developing',
      'description': 'Turn company lists into ranked target accounts. Discover promising prospects with website research and explainable scoring.',
      'site_url': '#',
      'social_handles': {
        'x': '#',
        'facebook': '#',
        'instagram': '#',
        'tiktok': '#'
      }
    },
    {
      'name': 'StashSage',
      'logo_url': 'output/assets/stashsage_logo.webp',
      'logo_alt': 'StashSage logo',
      'contact_email': 'datawiseguysllc@gmail.com',
      'status': 'Released',
      'description': 'Price Path of Exile 2 items faster with local machine learning, in-game overlays, and Discord lookups. Spend less time searching trade listings.',
      'site_url': 'https://rheinze08.github.io/StashSage/',
      'social_handles': {'x': '#', 'facebook': '#', 'instagram': '#', 'tiktok': '#', 'discord': '#'}
    },
    {
      'name': 'Insight Connect',
      'logo_url': 'output/assets/insight_connect_logo_20260310.webp',
      'logo_alt': 'Insight Connect logo',
      'contact_email': '',
      'status': 'Developing',
      'description': 'Turn domain data into dashboards and clear business answers. Explore datasets with AI-assisted analysis and reusable pipelines.',
      'site_url': '#',
      'social_handles': {
        'x': '#',
        'facebook': '#',
        'instagram': '#',
        'tiktok': '#'
      }
    },
    {
      'name': 'RolyCode',
      'logo_url': 'output/assets/rolycode_logo.webp',
      'logo_alt': 'RolyCode logo',
      'contact_email': '',
      'status': 'Released',
      'description': 'Bring coding agents, prompts, and conversations into one local workspace. Manage your workflows from desktop or mobile.',
      'site_url': 'https://www.rolycode.com',
      'social_handles': {'x': '#', 'facebook': '#', 'instagram': '#', 'tiktok': '#', 'discord': '#'}
    }
  ]) %}
  {% set team_members = team_members | default([
    {
      'name': 'Roland Heinze',
      'image_url': 'output/assets/roland_heinze_portrait_20260317.webp',
      'image_alt': 'Portrait of Roland Heinze',
      'position': 'Founder, CEO | Senior Data Scientist',
      'description': 'Background in Economics. Building practical tools for automation, analytics, and better decisions.',
      'minnect_url': '',
      'linkedin_url': 'https://www.linkedin.com/in/roland-heinze-49877542/'
    },
    {
      'name': 'Dylan Cael',
      'image_url': 'output/assets/dylan_cael_headshot_20260717.webp',
      'image_alt': 'Headshot of Dylan Cael',
      'position': 'AI Engineer',
      'description': 'Background in Computer Science.',
      'minnect_url': '',
      'linkedin_url': ''
    }
  ]) %}

  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-shell">
    <header class="site-hero" id="top">
      <div class="topbar">
        <div class="brand-lockup">
          <p class="brand-kicker">Operator-led software portfolio</p>
          <a class="brand-name" href="#top">{{ company_name }}</a>
        </div>

        <nav class="topnav" aria-label="Primary">
          <a class="nav-pill" href="#projects">Projects</a>
          <a class="nav-pill" href="#team">Team</a>
          <a class="nav-pill nav-pill-accent" href="mailto:{{ company_email }}">Contact</a>
        </nav>
      </div>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Operator-led data ventures</p>
          <h1>Practical software for complex workflows.</h1>
          <p class="hero-text">{{ company_tagline }}</p>

          <div class="hero-actions">
            <a class="hero-action hero-action-primary" href="#projects">Explore Projects</a>
            <a class="hero-action" href="#team">Meet the Team</a>
          </div>

          {% if social_links.x != '#' or social_links.facebook != '#' or social_links.instagram != '#' or social_links.tiktok != '#' %}
          <div class="social-row">
            {% if social_links.x != '#' %}
            <a class="social-pill" href="{{ social_links.x }}" target="_blank" rel="noopener noreferrer">X</a>
            {% endif %}
            {% if social_links.facebook != '#' %}
            <a class="social-pill" href="{{ social_links.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            {% endif %}
            {% if social_links.instagram != '#' %}
            <a class="social-pill" href="{{ social_links.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            {% endif %}
            {% if social_links.tiktok != '#' %}
            <a class="social-pill" href="{{ social_links.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>
            {% endif %}
          </div>
          {% endif %}
        </div>

        <aside class="hero-panel">
          <div class="hero-logo-shell">
            <img class="hero-logo" width="300" height="240" src="{{ company_logo_url }}" alt="Data WiseGuys, LLC logo">
          </div>
          <p class="panel-label">Independent software studio</p>
          <p class="portfolio-summary"><strong>{{ projects | selectattr('status', 'equalto', 'Released') | list | length }} released</strong> &middot; {{ projects | rejectattr('status', 'equalto', 'Released') | list | length }} in development</p>
        </aside>
      </div>
    </header>

    <main class="page-sections" id="main-content" tabindex="-1">
      <section class="section-shell" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Current builds</p>
            <h2 id="projects-title">Projects</h2>
          </div>
          <p>Released products and active builds shaped around practical workflows, signals, and decisions.</p>
        </div>

        <div class="project-group">
          <div class="project-group-heading">
            <h3>Released</h3>
          </div>
          <div class="project-grid">
          {% for project in projects if project.status == 'Released' %}
            {% set project_social_handles = project.social_handles | default({
              'x': '#',
              'facebook': '#',
              'instagram': '#',
              'tiktok': '#'
            }) %}
            {% set project_site_label = project.site_label | default('Visit Site') %}
            {% set has_project_site = project.site_url and project.site_url != '#' %}
            {% set has_project_social = (
              (project_social_handles.x and project_social_handles.x != '#') or
              (project_social_handles.facebook and project_social_handles.facebook != '#') or
              (project_social_handles.instagram and project_social_handles.instagram != '#') or
              (project_social_handles.tiktok and project_social_handles.tiktok != '#') or
              (project_social_handles.discord and project_social_handles.discord != '#')
            ) %}

          <article class="project-card">
            <div class="project-media">
              <img class="project-logo" width="220" height="112" loading="lazy" decoding="async" src="{{ project.logo_url }}" alt="{{ project.logo_alt }}">
            </div>

            <div class="project-copy">
              <span class="project-status{% if project.status != 'Released' %} project-status-developing{% endif %}">{{ project.status }}</span>
              <h4>{{ project.name }}</h4>
              <p class="project-description">{{ project.description }}</p>
            </div>

            <div class="project-card-footer">
            {% if has_project_site or project.contact_email %}
            <div class="project-actions">
              {% if has_project_site %}
              <a class="project-action project-action-primary" href="{{ project.site_url }}" target="_blank" rel="noopener noreferrer">{{ project_site_label }}</a>
              {% endif %}
              {% if project.contact_email %}
              <a class="project-action" href="mailto:{{ project.contact_email }}">Email</a>
              {% endif %}
            </div>
            {% endif %}

            {% if has_project_social %}
            <div class="social-row">
              {% if project_social_handles.x and project_social_handles.x != '#' %}
              <a class="social-pill" href="{{ project_social_handles.x }}" target="_blank" rel="noopener noreferrer">X</a>
              {% endif %}
              {% if project_social_handles.facebook and project_social_handles.facebook != '#' %}
              <a class="social-pill" href="{{ project_social_handles.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
              {% endif %}
              {% if project_social_handles.instagram and project_social_handles.instagram != '#' %}
              <a class="social-pill" href="{{ project_social_handles.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
              {% endif %}
              {% if project_social_handles.tiktok and project_social_handles.tiktok != '#' %}
              <a class="social-pill" href="{{ project_social_handles.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>
              {% endif %}
              {% if project_social_handles.discord and project_social_handles.discord != '#' %}
              <a class="social-pill" href="{{ project_social_handles.discord }}" target="_blank" rel="noopener noreferrer">Discord</a>
              {% endif %}
            </div>
            {% endif %}

            {% if not has_project_site and not project.contact_email and not has_project_social %}
            <p class="empty-note">Launch details coming soon.</p>
            {% endif %}
            </div>
          </article>
          {% endfor %}
          </div>
        </div>

        <div class="project-group">
          <div class="project-group-heading">
            <h3>Developing</h3>
          </div>
          <div class="project-grid">
          {% for project in projects if project.status != 'Released' %}
            {% set project_social_handles = project.social_handles | default({
              'x': '#',
              'facebook': '#',
              'instagram': '#',
              'tiktok': '#'
            }) %}
            {% set project_site_label = project.site_label | default('Visit Site') %}
            {% set has_project_site = project.site_url and project.site_url != '#' %}
            {% set has_project_social = (
              (project_social_handles.x and project_social_handles.x != '#') or
              (project_social_handles.facebook and project_social_handles.facebook != '#') or
              (project_social_handles.instagram and project_social_handles.instagram != '#') or
              (project_social_handles.tiktok and project_social_handles.tiktok != '#') or
              (project_social_handles.discord and project_social_handles.discord != '#')
            ) %}

          <article class="project-card">
            <div class="project-media">
              <img class="project-logo" width="220" height="112" loading="lazy" decoding="async" src="{{ project.logo_url }}" alt="{{ project.logo_alt }}">
            </div>

            <div class="project-copy">
              <span class="project-status{% if project.status != 'Released' %} project-status-developing{% endif %}">{{ project.status }}</span>
              <h4>{{ project.name }}</h4>
              <p class="project-description">{{ project.description }}</p>
            </div>

            <div class="project-card-footer">
            {% if has_project_site or project.contact_email %}
            <div class="project-actions">
              {% if has_project_site %}
              <a class="project-action project-action-primary" href="{{ project.site_url }}" target="_blank" rel="noopener noreferrer">{{ project_site_label }}</a>
              {% endif %}
              {% if project.contact_email %}
              <a class="project-action" href="mailto:{{ project.contact_email }}">Email</a>
              {% endif %}
            </div>
            {% endif %}

            {% if has_project_social %}
            <div class="social-row">
              {% if project_social_handles.x and project_social_handles.x != '#' %}
              <a class="social-pill" href="{{ project_social_handles.x }}" target="_blank" rel="noopener noreferrer">X</a>
              {% endif %}
              {% if project_social_handles.facebook and project_social_handles.facebook != '#' %}
              <a class="social-pill" href="{{ project_social_handles.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
              {% endif %}
              {% if project_social_handles.instagram and project_social_handles.instagram != '#' %}
              <a class="social-pill" href="{{ project_social_handles.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
              {% endif %}
              {% if project_social_handles.tiktok and project_social_handles.tiktok != '#' %}
              <a class="social-pill" href="{{ project_social_handles.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>
              {% endif %}
              {% if project_social_handles.discord and project_social_handles.discord != '#' %}
              <a class="social-pill" href="{{ project_social_handles.discord }}" target="_blank" rel="noopener noreferrer">Discord</a>
              {% endif %}
            </div>
            {% endif %}

            {% if not has_project_site and not project.contact_email and not has_project_social %}
            <p class="empty-note">Launch details coming soon.</p>
            {% endif %}
            </div>
          </article>
          {% endfor %}
          </div>
        </div>
      </section>

      <section class="section-shell section-shell-team" id="team" aria-labelledby="team-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Our people</p>
            <h2 id="team-title">Our Team</h2>
          </div>
          <p>The company is built around hands-on product execution, with each product shaped around a clear workflow or decision problem.</p>
        </div>

        <div class="team-grid">
          {% for member in team_members %}
          <article class="team-card">
            <div class="team-photo-wrap">
              {% if member.image_url %}
              <img class="team-photo" width="112" height="140" loading="lazy" decoding="async" src="{{ member.image_url }}" alt="{{ member.image_alt }}">
              {% else %}
              <div class="team-photo-placeholder" role="img" aria-label="{{ member.image_alt }}">DC</div>
              {% endif %}
            </div>

            <div class="team-copy">
              <h3>{{ member.name }}</h3>
              <p class="member-role">{{ member.position }}</p>
              <p class="member-description">{{ member.description }}</p>

              {% if member.minnect_url or member.linkedin_url %}
              <div class="profile-links">
                {% if member.linkedin_url %}
                <a class="profile-link" href="{{ member.linkedin_url }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                {% endif %}
                {% if member.minnect_url %}
                <a class="profile-link" href="{{ member.minnect_url }}" target="_blank" rel="noopener noreferrer">Minnect</a>
                {% endif %}
              </div>
              {% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="contact-row">
        <div><h2>Have a question about our products?</h2><a class="panel-email" href="mailto:{{ company_email }}">{{ company_email }}</a></div>
        <a class="nav-pill nav-pill-accent" href="mailto:{{ company_email }}">Get in Touch</a>
      </div>
      <div class="footer-bottom">
        <p class="footer-note">{{ company_name }} &middot; Independent software studio</p>
        <div class="social-row" aria-label="Founder social profiles">
          <a class="social-pill" href="https://x.com/rheinze08" target="_blank" rel="noopener noreferrer">X</a>
          <a class="social-pill" href="https://www.facebook.com/profile.php?id=61582292837909" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a class="social-pill" href="https://www.instagram.com/heinze_roland/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a class="social-pill" href="https://discord.gg/k58TnRgFPb" target="_blank" rel="noopener noreferrer">Discord</a>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
